FROM docker.io/library/nginx:stable-alpine
COPY web/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
# In this image, browser requests use nginx's /api proxy to the gateway.
# The source frontend and its local development URL are unchanged.
RUN sed -i 's#http://localhost:8443##g' /usr/share/nginx/html/js/services/api.js
EXPOSE 80
